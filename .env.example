# 复制为 .env 并填入真实值(.env 含密钥,已在 .gitignore)
# GitHub PAT(读公开仓库权限即可):元数据补全用,Actions 中配为 secret GH_PAT
GITHUB_TOKEN=
# 智谱 GLM API key:每日增量的 AI 画像,Actions 中配为 secret GLM_API_KEY
GLM_API_KEY=
# 模型档位,默认免费档;质量要求高可换 glm-4.6
GLM_MODEL=glm-4.5-flash
# 飞书推送二选一:
# 方式A 群机器人 webhook(群聊)
FEISHU_WEBHOOK=
# 方式B 自建应用(可发私聊,与 004 项目同一应用)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_ID=
FEISHU_CHAT_ID=

# ---- 本地网页自动同步(可选;关闭后 Web 仍可查询本地已有数据) ----
# 是否启用后台自动同步(默认 true;测试与离线场景可设 false)
DATA_SYNC_ENABLED=true
# 数据来源仓库与分支(只读,不做任何 Git 写操作)
DATA_SYNC_REPO=Neal-1991/github-trending-kb
DATA_SYNC_BRANCH=main
# 自动检查周期(秒,默认 1800=30 分钟)
DATA_SYNC_INTERVAL_SECONDS=1800
# 可选只读 Token(公共仓库可留空;限流或私有仓库时使用,仅发往 api.github.com)
DATA_SYNC_TOKEN=
